# 复制成 .env 再改（.env 已被 .gitignore 忽略，不会进仓库）。
# 环境变量优先于这个文件。
# 值只认字面量：不展开 %USERPROFILE%、$HOME 这类变量。

# Unpaywall / Crossref 按规范要求带一个真邮箱；不填就跳过 Unpaywall 那条路线
LITFETCH_EMAIL=you@example.com

# 浏览器 profile 目录（默认 ~/.litfetch_profile）。它存着 cf_clearance，
# 换目录等于把已通过的 Cloudflare 挑战丢掉 —— 详见 README「Cloudflare 挑战」一节。
# LITFETCH_PROFILE=C:\Users\<you>\.litfetch_profile

# realcheck.py 的标题夹具（可选；没有就只验 %PDF 不验标题）
# LITFETCH_FIXTURES=out\fixtures.json

# 付费刊（Unpaywall 说 closed）要不要试一次出版商的正文页。默认 1（试）。
# 有机构 IP（校网/VPN）时那是唯一的路；关掉写 0，等价于 --no-paywall。
# LITFETCH_PAYWALL=0
